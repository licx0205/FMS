# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传到 git）
# 云函数部署时，请将这些键值配置到控制台「环境变量」中，而非写死在代码里。

# ===== MySQL 数据库连接 =====
DB_HOST=sh-cynosdbmysql-grp-kqkuosoo.sql.tencentcdb.com
DB_PORT=29504
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# ===== CloudBase 环境 ID =====
TCB_ENV=your_env_id
